{
  "name": "solana-limit-order",
  "version": "0.1.0",
  "description": "Solana Limit Order Exchange",
  "scripts": {
    "test": "anchor test",
    "build": "anchor build",
    "deploy": "anchor deploy",
    "deploy-localnet": "ts-node scripts/deploy.ts config/deploy-config-localnet.json --network localnet",
    "deploy-devnet": "ts-node scripts/deploy.ts config/deploy-config-devnet.json --network devnet",
    "deploy-mainnet": "ts-node scripts/deploy.ts config/deploy-config-mainnet.json --network mainnet",
    "upload-idl": "anchor idl upgrade -f target/idl/limit_order.json C4Xn6ACR3XmTwpWm2fN82QSAx23TQkwVW8wro9Hdpqef || anchor idl init -f target/idl/limit_order.json C4Xn6ACR3XmTwpWm2fN82QSAx23TQkwVW8wro9Hdpqef",
    "verify-idl": "anchor idl fetch C4Xn6ACR3XmTwpWm2fN82QSAx23TQkwVW8wro9Hdpqef"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.0",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.3.4",
    "dotenv": "^16.0.0",
    "https-proxy-agent": "^7.0.6",
    "js-sha3": "^0.9.2",
    "mocha": "^9.0.3",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "undici": "^7.18.2"
  }
}
